{
  "name": "gladys-lennox-s30",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for Lennox S30, E30 and M30 thermostats over their local API (zones, temperature, humidity, setpoints, modes, fan, alerts; Off always available, other commands optional). Unofficial, not affiliated with Lennox.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
